programa {
  funcao inicio() {
// a) simples, pois conte apenas o SE
// b) composta, contem o SE e o SENAO("caso contrario")
// c) simples, contem apena so SE
// d) composta, contem o SE e o SENAO

real saldo, recarga

escreva("o valor da recarga é de: ",recarga = 30,"\n")
escreva("informe o valor do sel saldo atual: ")
leia(saldo)

se(saldo < recarga){

 retorne escreva("saldo insuficiente")
}
escreva("saldo suficiente. seu saldo restante é de: ",saldo - recarga )


  }
}
 
