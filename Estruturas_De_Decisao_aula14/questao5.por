programa {
  funcao inicio() {
    //ERRO1: antes, na linha 10, o comando dizia que apenas pessoas de 18 anos eram maiores de idade
    
    
    
    inteiro idade
escreva("Digite sua idade: ")
leia(idade)
se (idade >= 18) {
escreva("Entrada permitida.\n")
} senao {
escreva("Entrada negada — menor de idade.\n")
  }
}
}
