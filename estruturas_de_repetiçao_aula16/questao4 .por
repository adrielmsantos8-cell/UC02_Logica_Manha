programa {
  funcao inicio() {
  
inteiro  pontaverde, beneditobentes, tabuleiro, pajucara,linhas

escreva("linhas disponiveis: 1--->|pajuçara| 2--->|ponta verde| 3--->|beneditobentes| 4--->|tabuleiro|")
leia(linhas)


escolha(linhas){

caso 1:

linhas = 1
escreva("destino pajuçara")
pare
caso 2:

linhas = 2
escreva("destino ponta verde")
pare 
caso 3: 

linhas = 3
escreva("destino beneditobentes")
pare
caso 4:

linhas = 4
escreva("destino tabuleiro")
pare 
 caso contrario:
  escreva("opçao invalida. tente novamente: ")
  leia(linhas)

}









}
  }
}
