programa {
  funcao inicio() {
// salariomensal | horastrabalhadas | resultado
// 3000          |     x            |  x 
// 3000          |    60            |  x
// 3000          |    60            |   50/hora
//
//


      real salariomensal, horastrabalhadas
 
 escreva("Qual foi o salario deste funcionario, neste mes?:")
   leia(salariomensal)
 escreva("Quantas horas este funcionario trabalhou esse mes: ")
   leia(horastrabalhadas)

escreva("este funcionario recebe por hora", salariomensal /horastrabalhadas)
  }
}
