programa {
  funcao inicio() {
    real num1, num2,adicao, subtracao, multiplicacao, divisao
 
   escreva("escreva um numero: ")
leia(num1)
   escreva("escreva outro numero: ")
leia(num2)

escreva("soma dos dois numeros: ", adicao = num1 + num2,"\n")
escreva("subtração dos dois numeros ",subtracao = num1 - num2,"\n")
escreva("multiplicação dos dois numeros",multiplicacao = num1 * num2,"\n")
escreva("divisão dos dois numeros",divisao = num1 / num2,"\n")
  }
}
